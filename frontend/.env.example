# Production: proxy browser API requests through the frontend origin so secure
# auth cookies and connection reuse work consistently.
BACKEND_URL=https://your-backend.example.com
NEXT_PUBLIC_API_PROXY_MODE=on
# Only set this for an intentional direct-browser API deployment.
NEXT_PUBLIC_API_URL=

# Public website-demo agent. The widget key is intentionally browser-visible;
# restrict it to approved origins in the agent's Widget settings.
NEXT_PUBLIC_WEBSITE_AGENT_ID=
NEXT_PUBLIC_WEBSITE_AGENT_PUBLIC_KEY=
